{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "env": { "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet" },
    "permissions": {
        "allow": [
            "Bash(npm run check *)", "Bash(npm run check:agent *)", "Bash(npm run check:offline *)",
            "Bash(npm test *)", "Bash(npm run test:quiet *)", "Bash(npm run lint *)",
            "Bash(npm run typecheck *)", "Bash(npm run guardrails *)", "Bash(npm run build *)",
            "Bash(npm run test:db *)", "Bash(npm run test:e2e *)", "Bash(npm run task -- show *)",
            "Bash(node --experimental-strip-types --test *)"
        ],
        "ask": [
            "Bash(git commit *)", "Bash(git push *)", "Bash(git merge *)", "Bash(gh pr merge *)",
            "Bash(npm install *)", "Bash(npm i *)", "Bash(npm update *)", "Bash(npm uninstall *)",
            "Bash(npm run smoke:ai *)"
        ],
        "deny": [
            "Read(.env)", "Read(.env.*)", "Read(!.env.example)",
            "Edit(.env)", "Edit(.env.*)", "Edit(!.env.example)"
        ]
    },
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Edit|Write|MultiEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/post-edit-check.mjs\"",
                        "timeout": 30
                    }
                ]
            }
        ]
    }
}