{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "es2022",
      "dom"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/domain/**/*.ts",
    "src/data/**/*.ts",
    "src/server/config.ts",
    "src/server/policy.ts",
    "src/server/ai/disabled.ts",
    "src/server/storage/fixture.ts",
    "tests/unit/**/*.ts"
  ]
}
