# Local defaults. ATLAS_ENV=production (DEPLOY-002) starts only with DATA_BACKEND=postgres,
# a secret of at least 32 bytes and an https:// NEXTAUTH_URL on a public host, keeps uploads
# off and has no sign-up. Any other value refuses. Backup and restore: the end of this file.
ATLAS_ENV=local
DATA_BACKEND=fixture
LIVE_AI_ENABLED=false
LIVE_SOURCES_ENABLED=false
UPLOADS_ENABLED=false
NEXT_TELEMETRY_DISABLED=1
# Session signing secret for next-auth; it also keys the login attempt counters, and login
# refuses without it. `npm run setup` fills it in for a new .env; otherwise generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# The address you open the app on, scheme and port included (`npm run dev` serves 127.0.0.1:3000).
# Unset, next-auth assumes http://localhost:3000 and warns; change the port here if you serve on another.
# In local and test a set value must be loopback (localhost, 127.x, [::1]): the app refuses to start otherwise.
NEXTAUTH_URL=http://127.0.0.1:3000
# Registrations per 15 minutes, service-wide (1 to 10 000; 10 when unset). Any other value
# refuses registration. `npm run test:e2e` registers about 33 accounts in this database (its
# server raises its own limit), so for up to 15 minutes after a run `npm run dev` may refuse
# new registrations.
REGISTRATION_LIMIT=

# Run npm run setup: creates a private .env with a random local DB password.
POSTGRES_USER=atlas
POSTGRES_PASSWORD=GENERATE_WITH_SETUP
POSTGRES_DB=atlas_starter
POSTGRES_PORT=54329
DATABASE_URL=GENERATE_WITH_SETUP

# An isolated disposable test database. Never point this at live/user data.
TEST_DATABASE_URL=

# Backups (DEPLOY-003): `npm run db:backup` writes into BACKUP_DIR, an absolute path outside
# this repository (the server uses /srv/nenaugad/backups). pg_dump and pg_restore must match
# the server's major version (17). Set at most one of the next two: PG_BIN_DIR names the
# client's directory (the server: /usr/lib/postgresql/17/bin), PG_TOOLS_CONTAINER runs the
# tools inside the database container instead (a development machine without that client:
# nenaugad-db-1). Both empty: pg_dump from PATH. `npm run test:db` needs one that works.
BACKUP_DIR=
PG_BIN_DIR=
PG_TOOLS_CONTAINER=
