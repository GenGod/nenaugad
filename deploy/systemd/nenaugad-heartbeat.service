# Nenaugad heartbeat to the external monitor (DEPLOY-006). Started by nenaugad-heartbeat.timer.
# Off until owner decision D7 names the monitoring service; deploy/README.md, Monitoring.
#   sudo install -m 755 -o root -g root deploy/nenaugad-heartbeat.sh /usr/local/sbin/nenaugad-heartbeat
#   sudo install -m 644 -o root -g root deploy/systemd/nenaugad-heartbeat.service /etc/systemd/system/
#   sudo install -m 644 -o root -g root deploy/systemd/nenaugad-heartbeat.timer /etc/systemd/system/

[Unit]
Description=Nenaugad heartbeat (worker steady, disk below threshold)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# Read by systemd as root before the service starts; holds HEARTBEAT_URL only.
EnvironmentFile=/etc/nenaugad/heartbeat.env
ExecStart=/usr/local/sbin/nenaugad-heartbeat
# It only reads unit state over D-Bus, runs df and makes one HTTPS request.
DynamicUser=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
