{
  "name": "nenaugad",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nenaugad (ex-Atlas starter): local-only, read-only starter for Solo Pipeline SP 1.0",
  "engines": {
    "node": "^22.16.0 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "doctor": "node --experimental-strip-types --env-file-if-exists=.env scripts/doctor.ts",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "tokens": "node scripts/tokens.mjs",
    "tokens:check": "node scripts/tokens.mjs --check",
    "icons": "node scripts/icons.mjs",
    "icons:check": "node scripts/icons.mjs --check",
    "lint": "biome lint --error-on-warnings src scripts tests next.config.ts playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "guardrails": "node scripts/guardrails.mjs",
    "check:offline": "npm run tokens:check && npm run icons:check && npm run guardrails && npm test",
    "check": "npm run check:offline && npm run lint && npm run typecheck",
    "test:quiet": "node scripts/test-quiet.mjs",
    "check:agent": "npm run -s tokens:check && npm run -s icons:check && npm run -s guardrails && npm run -s test:quiet && npm run -s lint && npm run -s typecheck",
    "ci:status": "node --experimental-strip-types scripts/ci-status.ts",
    "db:migrate": "node --experimental-strip-types --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "node --experimental-strip-types --env-file-if-exists=.env scripts/seed.ts",
    "test:db": "node --experimental-strip-types --env-file-if-exists=.env --test --test-concurrency=1 tests/integration/*.test.ts",
    "test:coverage": "node --experimental-strip-types --env-file-if-exists=.env --test --test-concurrency=1 --experimental-test-coverage --test-coverage-include-all --test-coverage-include=src/**/*.ts --test-coverage-lines=82 --test-coverage-branches=86--test-coverage-functions=91 tests/unit/*.test.ts tests/integration/*.test.ts",
    "test:e2e": "playwright test",
    "import:himalayas": "node --experimental-strip-types --env-file-if-exists=.env scripts/import-himalayas.ts",
    "import:jobicy": "node --experimental-strip-types --env-file-if-exists=.env scripts/import-jobicy.ts",
    "worker": "node --experimental-strip-types --env-file-if-exists=.env scripts/worker.ts",
    "seed:budgets": "node --experimental-strip-types --env-file-if-exists=.env scripts/seed-ai-budgets.ts",
    "ai:holds": "node --experimental-strip-types --env-file-if-exists=.env scripts/ai-holds.ts",
    "smoke:ai": "node --experimental-strip-types --env-file-if-exists=.env scripts/smoke-ai.ts",
    "smoke:himalayas": "node --experimental-strip-types scripts/smoke-himalayas.ts",
    "terms:check": "node --experimental-strip-types scripts/terms-check.ts",
    "models:fetch": "node --experimental-strip-types scripts/models-fetch.ts",
    "esco:fetch": "node --experimental-strip-types scripts/esco-fetch.ts",
    "models:fetch-llm": "node --experimental-strip-types scripts/models-fetch-llm.ts",
    "eval:local-llm": "node --experimental-strip-types scripts/eval-local-llm.ts",
    "embeddings:index": "node --experimental-strip-types --env-file-if-exists=.env scripts/embeddings-index.ts",
    "extract:fields": "node --experimental-strip-types --env-file-if-exists=.env scripts/extract-fields.ts",
    "dedup:candidates": "node --experimental-strip-types --env-file-if-exists=.env scripts/dedup-candidates.ts",
    "eval:matching": "node --experimental-strip-types scripts/eval-matching.ts",
    "eval:dense": "node --experimental-strip-types scripts/eval-dense.ts",
    "eval:retrieval": "node --experimental-strip-types scripts/eval-retrieval.ts",
    "task": "node scripts/task.mjs",
    "syntax": "node scripts/check-syntax.cjs",
    "eval:shadow": "node --experimental-strip-types scripts/eval-shadow.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.0",
    "next": "16.3.6",
    "next-auth": "4.24.15",
    "openai": "7.23.0",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@playwright/test": "1.62.1",
    "@types/node": "22.15.30",
    "@types/pg": "8.15.4",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "typescript": "5.9.3"
  }
}
